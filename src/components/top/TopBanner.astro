---
import Image from 'astro/components/Image.astro';
import mv from '@assets/img/wisekai_mv_pc.jpg';
---

<a href="/" class="flex justify-center overflow-hidden bg-gray-200">
  <Image class="mv" src={mv} alt="ヰ世界情緒 -Isekaijoucho- YouTubeチャンネル" />
</a>

<style>
  .mv {
    clip-path: inset(0 20% 0 20%);
    margin-left: -10%;
    max-width: 180%;
  }
  @media (min-width: 768px) {
    .mv {
      clip-path: none;
      margin-left: 0;
      max-width: 100%;
    }
  }
</style>
